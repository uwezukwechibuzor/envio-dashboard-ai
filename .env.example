# ── Envio ──────────────────────────────────────────────────────────────────────
# API token for HyperSync. Create one at: https://envio.dev/app/api-tokens
ENVIO_API_TOKEN=your_envio_api_token_here

# ── Anthropic ──────────────────────────────────────────────────────────────────
# API key for the Claude agent loop. https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Database ───────────────────────────────────────────────────────────────────
# Postgres connection string for Drizzle ORM (daily series cache)
DATABASE_URL=postgresql://user:password@localhost:5432/envio_dashboard

# ── Redis (optional) ───────────────────────────────────────────────────────────
# Used for job queue if background backfill is enabled
REDIS_URL=redis://localhost:6379

# ── App ────────────────────────────────────────────────────────────────────────
# Public base URL (used for shareable dashboard links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment
NODE_ENV=development

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Max agent tool-call turns per request (default: 20)
AGENT_MAX_TURNS=20

# ── HyperIndex endpoints (override defaults) ───────────────────────────────────
# These default to Envio Cloud endpoints; override for self-hosted deployments
# HYPERINDEX_UNISWAP_V3_URL=http://localhost:8080/v1/graphql
# HYPERINDEX_UNISWAP_V4_URL=http://localhost:8081/v1/graphql
# HYPERINDEX_AAVE_V3_URL=http://localhost:8082/v1/graphql
# HYPERINDEX_DEX_PRICES_URL=http://localhost:8083/v1/graphql
