# Envio HyperSync API token — create at https://envio.dev/app/api-tokens
ENVIO_API_TOKEN=

# Anthropic API key — create at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# PostgreSQL database URL (Drizzle + postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/envio_dashboard

# Auth.js / NextAuth secret — run: openssl rand -hex 32
AUTH_SECRET=

# GitHub OAuth app credentials — create at https://github.com/settings/developers
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Public URL (required for OAuth callback URL and OG image generation)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sentry error tracking — create project at https://sentry.io
# SENTRY_DSN=https://...@sentry.io/...
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
# SENTRY_AUTH_TOKEN=  (CI use only, for source map upload)

# Rate limiting (defaults shown)
# AGENT_RATE_LIMIT_PER_DAY=50
