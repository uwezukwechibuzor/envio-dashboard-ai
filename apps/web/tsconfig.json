{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@envio-dashboard-ai/core": ["../../packages/core/src/index.ts"],
      "@envio-dashboard-ai/agent": ["../../packages/agent/src/index.ts"],
      "@envio-dashboard-ai/metrics": ["../../packages/metrics/src/index.ts"],
      "@envio-dashboard-ai/hypersync": ["../../packages/hypersync/src/index.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
