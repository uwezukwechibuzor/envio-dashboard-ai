{
  "name": "envio-dashboard-ai",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "test": "vitest run",
    "test:reconcile": "vitest run --reporter=verbose packages/metrics/src/packs/uniswap-v3/reconcile.test.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "dev": "pnpm --parallel dev",
    "metric": "tsx packages/metrics/src/cli.ts",
    "agent": "tsx packages/agent/src/cli.ts",
    "evals": "vitest run evals/",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.0"
  }
}
