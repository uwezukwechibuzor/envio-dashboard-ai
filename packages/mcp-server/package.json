{
  "name": "@envio-dashboard-ai/mcp-server",
  "version": "0.1.0",
  "description": "envio-data-mcp: MCP server exposing HyperSync/HyperIndex on-chain data tools",
  "type": "module",
  "bin": {
    "envio-data-mcp": "./dist/bin/envio-data-mcp.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup src/index.ts src/bin/envio-data-mcp.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/bin/envio-data-mcp.ts"
  },
  "dependencies": {
    "@envio-dashboard-ai/core": "workspace:*",
    "@envio-dashboard-ai/hypersync": "workspace:*",
    "@envio-dashboard-ai/metrics": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
